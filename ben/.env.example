# Diese Datei ist eine Vorlage. Auf Render trägst du dieselben Werte unter
# "Environment" ein — dort gehören sie hin, nicht in eine Datei im Repository.

# Pflicht ---------------------------------------------------------------

# Der Schlüssel aus der Anthropic Console. Er bleibt auf dem Server und
# erreicht den Browser nie.
ANTHROPIC_API_KEY=sk-ant-...

# Der Code, den die Coachin dem Klienten nennt. Frei wählbar, aber bitte
# nicht zu kurz — er ist die einzige Schwelle vor der App.
ZUGANGSCODE=beispiel-code-bitte-aendern

# Optional --------------------------------------------------------------

# Modell. Voreinstellung: claude-opus-5.
# claude-sonnet-5 ist deutlich günstiger und für dieses Gespräch gut geeignet.
# ANTHROPIC_MODEL=claude-opus-5

# Wie ausführlich das Modell nachdenkt: low, medium, high, xhigh, max.
# Voreinstellung low — kurze, ruhige Antworten, geringe Kosten.
# EFFORT=low

# Obergrenze für eine einzelne Antwort. Voreinstellung 16000.
# Die Abschluss-Zusammenfassung über sieben Blöcke braucht Platz.
# MAX_TOKENS=16000

# Ab wie vielen Zeichen Gesamtverlauf abgebrochen statt gekürzt wird.
# Voreinstellung 400000 (grob 120.000 Tokens). Siehe README.
# MAX_VERLAUF_ZEICHEN=400000

# Namen. Nur setzen, wenn die App für ein anderes Paar genutzt wird.
# Bleiben sie leer, steht in prompt.md genau das, was die Coachin
# geschrieben hat: Ben, Marc und Sophie.
# AGENT_NAME=Ben
# KLIENT_NAME=Marc
# PARTNERIN_NAME=Sophie
