        "base": { "__rl": true, "mode": "id", "value": "app9r4BK5FJTU219P" },
        "table": { "__rl": true, "mode": "id", "value": "tblkp0LVz3voBPEhr" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
