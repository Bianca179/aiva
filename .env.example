# --- Lexware Office (ehem. lexoffice) Public API ---
# API-Key erstellen: Lexware Office -> Einstellungen -> Erweiterungen -> Public API
LEXWARE_API_KEY=

# --- Claude API (Chatbot) ---
ANTHROPIC_API_KEY=

# --- Beleg-Import per E-Mail (IMAP-Postfach, z.B. belege@firma.de) ---
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Kommagetrennte Liste erlaubter Absender. Leer = alle Absender erlaubt.
MAIL_ALLOWED_SENDERS=
# Abruf-Intervall in Sekunden
MAIL_POLL_SECONDS=300

# true = Dashboard laeuft mit realistischen Beispieldaten (ohne API-Keys demonstrierbar)
DEMO_MODE=true
